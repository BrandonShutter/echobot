{
  "name": "echobot",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-powered Slack support bot for Echo, built for the TAM home assignment",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "ask": "bun scripts/ask.ts",
    "crawl-docs": "bun scripts/crawl-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "report": "bun scripts/report.ts",
    "eval": "bun scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "minisearch": "^7.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
