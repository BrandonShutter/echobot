# Slack: from your app's settings page (see README, "Create the Slack app")
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Optional
ECHOBOT_MODEL=claude-opus-5-5
ECHOBOT_EFFORT=medium
# ECHOBOT_ANTHROPIC_BASE_URL=https://api.anthropic.com
# Only for keys starting sk-ant-usr- (not scoped to a workspace): the workspace ID from console.anthropic.com
# ECHOBOT_ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Uncomment once demo-identities.json exists (see README)
# ECHOBOT_DEMO_IDENTITIES=./demo-identities.json
